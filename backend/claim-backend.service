[Unit]
Description=Claim Reconciliation FastAPI Backend Service
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/claim-reconciliation
ExecStart=/home/ubuntu/claim-reconciliation/backend/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
